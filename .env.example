# ─────────────────────────────────────────────────────────────────────────────
#  AdaalAI — Environment Configuration
#  Copy this file to .env and fill in your values
# ─────────────────────────────────────────────────────────────────────────────

# ── API Keys (at least one LLM provider is required) ─────────────────────────
# Option A: Groq (FREE — https://console.groq.com — recommended)
GROQ_API_KEY=your_groq_api_key_here

# Option B: OpenAI (paid, optional fallback)
OPENAI_API_KEY=

# ── LLM Settings ──────────────────────────────────────────────────────────────
# Provider: "groq" (free) or "openai"
LLM_PROVIDER=groq

# Groq model — llama3-8b-8192 is free and fast
LLM_MODEL=llama3-8b-8192

# Temperature: 0.1 = focused/deterministic (good for legal use)
LLM_TEMPERATURE=0.1

# ── Embedding Model (runs locally, no API key needed) ────────────────────────
# Will auto-download ~1.1GB on first run
EMBEDDING_MODEL=intfloat/multilingual-e5-large

# ── Database Paths ────────────────────────────────────────────────────────────
CHROMA_DB_PATH=./data/chroma_db
CASE_DATA_PATH=./data/cases.json

# ── Server Settings ───────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
RELOAD=true

# ── App Settings ──────────────────────────────────────────────────────────────
APP_NAME=AdaalAI
APP_VERSION=1.0.0
DEBUG=true

# ── CORS (add your frontend URL in production) ────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173
